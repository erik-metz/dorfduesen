    "@turf/area": "^7.4.0",
    "@turf/buffer": "^7.4.0",
    "@turf/difference": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "inngest": "^4.22.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "openai": "^7.30.0",
    "polyclip-ts": "^0.16.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "6.19.3",
