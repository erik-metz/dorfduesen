# Strava API Application Credentials
# Registriere deine App unter https://www.strava.com/settings/api
# "Authorization Callback Domain": localhost:3000 (oder deine Produktions-Domain)
STRAVA_CLIENT_ID="your_strava_client_id"
STRAVA_CLIENT_SECRET="your_strava_client_secret"

# Öffentliche URL der Anwendung
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Datenbank Verbindung (Neon PostgreSQL)
# Format: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:npg_xyz@ep-xyz-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Geheimes Token für Session-Signierung (beliebige 32+ Zeichen)
SESSION_SECRET="change-this-to-a-very-secure-random-32-char-secret-string"

# Optional: Schutz-Schlüssel für regelmäßige Cron-Syncs
CRON_SECRET="change-this-for-cron-sync-security"

# xAI (Grok API)
XAI_API_KEY="your-xai-api-key"

# Inngest (Background Workflow Engine)
# Für lokale Entwicklung reicht npx inngest-cli dev (Keys optional). In Produktion erforderlich:
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"
