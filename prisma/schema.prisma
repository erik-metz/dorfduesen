generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(cuid())
  stravaAthleteId String     @unique
  firstname       String?
  lastname        String?
  username        String?
  profile         String?
  city            String?
  country         String?
  sex             String?
  role            String     @default("MEMBER") // MEMBER | ADMIN
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  generationAttempts PlanGenerationAttempt[]
  syncState SyncState?
  account         Account?
  mobileAuthCodes MobileAuthCode[]
  mobileSessions  MobileSession[]
  activities      Activity[]
  syncLogs        SyncLog[]
  userBadges      UserBadge[]
  profileData     UserProfile?
  trainingPlans   TrainingPlan[]
  coachConversations CoachConversation[]
  coachChatQuota CoachChatQuota?
  healthMetrics   HealthMetric[]
  healthConnections MobileHealthConnection[]
  healthRecords   MobileHealthRecord[]
  notifications   Notification[]
  pushTokens      PushToken[]
  weeklyGoals WeeklyGoal[]
  weeklyTitleHolders  WeeklyTitleHolder[]
  monthlyTitleHolders MonthlyTitleHolder[]
}

model Account {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiresAt    Int
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Strava athletes who tried to sign in without being a club member. Approval creates the User row,
// so pending or rejected people never appear in member lists, leaderboards or syncs.
model AccessRequest {
  id              String    @id @default(cuid())
  stravaAthleteId String    @unique
  firstname       String?
  lastname        String?
  username        String?
  profile         String?
  city            String?
  country         String?
  status          String    @default("PENDING") // PENDING | REJECTED
  attemptCount    Int       @default(1)
  lastAttemptAt   DateTime  @default(now())
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, lastAttemptAt])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   // ios | android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model MobileOAuthState {
  id            String   @id @default(cuid())
  stateHash     String   @unique
  codeChallenge String
  redirectUri   String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([expiresAt])
}

model MobileAuthCode {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash      String   @unique
  codeChallenge String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model MobileSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Activity {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stravaId           String   @unique
  name               String
  distance           Float    // Distance in meters
  extractedDistance  Float?   // Distance recovered from a zero-distance activity title/description, in meters
  manualDistance     Float?   // User correction in meters
  movingTime         Int      // Moving time in seconds
  elapsedTime        Int      // Elapsed time in seconds
  totalElevationGain Float    // Meters
  sportType          String   // e.g. Run, Ride, TrailRun, Walk
  startDate          DateTime
  startDateLocal     DateTime
  timezone           String?
  averageSpeed       Float?   // m/s
  maxSpeed           Float?   // m/s
  averageHeartrate   Float?
  maxHeartrate       Float?
  kudosCount         Int      @default(0)
  commentCount       Int      @default(0)
  achievementCount   Int      @default(0)
  summaryPolyline    String?
  detailJson         Json?
  syncedAt           DateTime @default(now())
  territoryClaim     TerritoryClaim?
  matchedWorkouts    PlanWorkout[]

  @@index([userId])
  @@index([userId, startDate])
  @@index([startDate])
}

model SyncLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String   // SUCCESS | ERROR
  itemsSynced  Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Badge {
  id          String      @id @default(cuid())
  code        String      @unique // e.g. CENTURY_CLUB, SUNDAY_WARRIOR, DAWN_PATROL
  name        String
  description String
  icon        String      // Emoji or icon identifier
  category    String      // DISTANCE | STREAK | SPECIAL | SPEED | WEEKLY | MONTHLY | COMMUNITY
  rarity      String?     @default("COMMON") // COMMON | RARE | EPIC | LEGENDARY

  userBadges  UserBadge[]
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId    String
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  level      Int      @default(1)
  metadata   Json?
  unlockedAt DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([userId, badgeId])
  @@index([userId])
}

model Challenge {
  id          String   @id @default(cuid())
  title       String   // e.g. "1.000 km Ried-Challenge"
  description String
  targetKm    Float    // Target in kilometers
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
}

model UserProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate           DateTime?
  heightCm            Float?
  weightKg            Float?
  restingHeartrate    Int?
  maxHeartrate        Int?
  estimatedVo2max     Float?
  vdotScore           Float?
  weeklyAvailability  Int       @default(3) // 2 to 6 days
  preferredLongRunDay Int?                // null = Flexibel nach Wetter/Tagesform, 0 = Sonntag, 1 = Montag, etc.
  includeSundayRun    Boolean   @default(true) // Ob der DorfDüsen Sunday Run (5k) eingeplant werden soll
  preferredTerrain    String?   @default("ROAD") // ROAD | TRAIL | MIXED
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model TrainingPlan {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String       // e.g. "Halbmarathon Sub 1:45"
  goalType           String       // 5K | 10K | HALF_MARATHON | MARATHON | GENERAL_FITNESS | BASE_BUILD
  targetDistance     Float?       // in km (e.g. 21.1)
  targetTimeSeconds  Int?         // in seconds (e.g. 6300)
  targetDate         DateTime?
  startDate          DateTime
  endDate            DateTime
  status             String       @default("QUEUED") // QUEUED | PROCESSING | ACTIVE | PAUSED | COMPLETED | FAILED
  currentWeek        Int          @default(1)
  totalWeeks         Int
  inngestEventId     String?
  generationPrompt   String?
  coachingPhilosophy String?
  weeks              PlanWeek[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([userId])
}

model PlanWeek {
  id             String        @id @default(cuid())
  planId         String
  plan           TrainingPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekNumber     Int
  phase          String        // BASE | BUILD | PEAK | TAPER | RECOVERY
  targetDistance Float         // in km
  actualDistance Float         @default(0)
  isDeloadWeek   Boolean       @default(false)
  focusTitle     String?
  workouts       PlanWorkout[]

  @@index([planId])
}

model PlanWorkout {
  id                    String       @id @default(cuid())
  weekId                String
  week                  PlanWeek     @relation(fields: [weekId], references: [id], onDelete: Cascade)
  scheduledDate         DateTime
  sportType             String       @default("Run") // Run | Ride | Rest | Strength
  workoutType           String       // EASY | TEMPO | INTERVAL | LONGRUN | RECOVERY | REST
  title                 String
  description           String
  targetDistance        Float?       // in km
  targetDurationMinutes Int?
  targetPaceMin         String?      // "5:30"
  targetPaceMax         String?      // "5:45"
  targetHrZone          Int?         // 1, 2, 3, 4, 5
  structuredSteps       Json?        // Interval sequence
  isFlexible            Boolean      @default(true)
  recommendedTiming     String?      // "Wochenende (nach Wetter)", "Dienstag", "Unter der Woche"
  status                String       @default("PENDING") // PENDING | COMPLETED | SKIPPED | ADAPTED
  matchedActivityId     String?
  matchedActivity       Activity?    @relation(fields: [matchedActivityId], references: [id], onDelete: SetNull)
  aiFeedback            String?

  @@index([weekId])
  @@index([matchedActivityId])
  @@index([scheduledDate])
}

model HealthMetric {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime  @default(now())
  weightKg         Float?
  restingHeartrate Int?
  notes            String?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([userId, date])
}

model MobileHealthConnection {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider         String   // APPLE_HEALTH | HEALTH_CONNECT
  consentedTypes   String[] @default([])
  consentVersion   String?
  consentedAt      DateTime?
  revokedAt        DateTime?
  lastSyncedAt     DateTime?
  syncCursor       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId, revokedAt])
}

model MobileHealthRecord {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   // APPLE_HEALTH | HEALTH_CONNECT
  recordId     String   // Stable source identifier, used for idempotent updates
  recordType   String   // e.g. workout, heart_rate, sleep, weight
  startAt      DateTime
  endAt        DateTime?
  value        Json     // Normalized summary and supported metadata, never access tokens
  sourceName   String?
  sourceId     String?
  recordedAt   DateTime?
  importedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider, recordId])
  @@index([userId, recordType, startAt])
  @@index([userId, provider, startAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // TITLE_LOST | TITLE_GAINED | SYSTEM
  title     String
  message   String
  link      String?  @default("/arena")
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model WeeklyTitleHolder {
  id          String   @id @default(cuid())
  weekKey     String   // Monday of the week YYYY-MM-DD
  titleId     String   // elevation | distance | time | heartrate | early_bird | consistency
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value       Float
  isFinalized Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([weekKey, titleId])
  @@index([weekKey])
  @@index([userId])
}

model MonthlyTitleHolder {
  id          String   @id @default(cuid())
  monthKey    String   // Month key YYYY-MM
  titleId     String   // month_king | century_club | double_century | month_streaker | bike_king
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  value       Float
  isFinalized Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([monthKey, titleId])
  @@index([monthKey])
  @@index([userId])
}


model PlanGenerationAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SiteSyncState {
  id          String   @id
  owner       String
  requestedAt DateTime
}

model SyncState {
  userId              String    @id
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  historicalPage      Int       @default(1)
  historicalBefore    Int?
  historyCompletedAt  DateTime?
  lastSyncedAt        DateTime?
  lockOwner           String?
  lockedUntil         DateTime?
}

model WeeklyGoal {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekKey String
  activeDays Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekKey])
}

model InstagramFeedState {
  accessToken    String?
  tokenUpdatedAt DateTime?
  id             String   @id
  posts          Json
  syncedAt       DateTime
}

// One authoritative evaluation per activity. Ownership is derived by chronological replay.
model TerritoryClaim {
  id           String   @id @default(cuid())
  activityId   String   @unique
  activity     Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  sourceHash   String
  rulesVersion Int
  status       String   // VALID | REJECTED
  reason       String?
  geometry     Json?
  endedAt      DateTime @db.Timestamptz(3)
  checkedAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([endedAt, status])
}

model TerritorySettings {
  id        String   @id
  enabledAt DateTime @default(now()) @db.Timestamptz(3)
}

// Shared, durable projection snapshot so map requests do not replay geometry per Vercel instance.
model TerritoryProjectionCache {
  seasonKey      String   @id
  inputHash      String?
  projection     Json?
  failedInputHash String?
  retryAt        DateTime? @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
}

model CoachConversation {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  turns     CoachTurn[]

  @@index([userId, updatedAt, id])
}

model CoachTurn {
  id             String            @id
  conversationId String
  conversation   CoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  question       String
  answer         String?
  proposal       Json?
  sources        Json?
  status         String            @default("PENDING")
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt, id])
}

model CoachChatQuota {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    String
  count  Int
  premiumCount Int @default(0)
}

model CoachModelCatalog {
  id          Int      @id
  data        Json?
  nextRefresh DateTime
}

model CoachSpend {
  month String @id
  ticks BigInt
}
